{
  "name": "republika",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @republika/desktop dev",
    "dev:web": "pnpm --filter @republika/desktop dev:web",
    "build": "pnpm --filter @republika/desktop build",
    "build:web": "pnpm --filter @republika/desktop build:web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm build:web && playwright test",
    "content:check": "pnpm --filter @republika/game-data content:check",
    "format": "prettier --write .",
    "test:coverage": "vitest run --project simulation --coverage.enabled --coverage.provider=v8 --coverage.include=packages/simulation/src/** --coverage.reporter=text-summary --coverage.reporter=text --coverage.thresholds.lines=90"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.21",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "fast-check": "^3.23.2",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.4"
  }
}
